{
  // nathanhaslewood.com.au — static assets only, no Worker script.
  // Name must match the repo name or Workers Builds overrides it and opens a PR.
  "name": "nathanhaslewoodportfolio",
  "compatibility_date": "2026-09-01",

  // AFTER the custom domain is live and verified, change both of these to false.
  // Leaving them true serves the whole site a second time on *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./",
    // serves /work/ from /work/index.html and keeps the trailing-slash URLs intact
    "html_handling": "auto-trailing-slash",
    // uses the existing 404.html rather than a Cloudflare default
    "not_found_handling": "404-page"
  }
}
